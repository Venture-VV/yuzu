# 一个网关进程的配置（docs/DEPLOY_GATEWAY.md 第 4 节）：
#   cp gateway.env.example gateway-test.env    测试网关（连测试服 A 的演示库）
#   cp gateway.env.example gateway-prod.env    正式网关（yuzu 正式切换后，连门店 Mac mini 正式服）
# 这两个文件里有密钥：chmod 600，不进 Git，不发给云端会话。测试、正式的网关会话密钥各用各的。

# yuzu 的小程序端口（经 Tailscale）：用那台机器的 Tailscale 地址（tailscale ip -4，100 开头），不用 MagicDNS 名字（容器里不一定解析得了）
#   测试网关：测试服 A 的地址 + 演示库的小程序端口；正式网关：门店 Mac mini 的地址 + 正式服的小程序端口
MP_UPSTREAM_URL=http://100.64.0.10:8081

# 与那台 yuzu 的 .env 里的 MP_GATEWAY_KEY 相同（openssl rand -hex 32 生成一次，两边各填一份）
MP_GATEWAY_KEY=

# 网关会话的签名密钥：只在网关（openssl rand -hex 32）；换了之后顾客要重新打开小程序登录一次
MP_SESSION_SECRET=

# 小程序的 AppID 与 AppSecret（小程序后台「开发管理 → 开发设置」）；测试、正式两个网关填同一个小程序的
WX_APPID=
WX_APPSECRET=

# 模拟微信（假登录、假手机号）：只在还没有 AppID 时、测试网关连演示库临时用。正式网关不要开（正式、演练的 yuzu 也会拒绝模拟绑定）
# MP_MOCK_WECHAT=true

# MP_SESSION_DAYS=7
# LOG_LEVEL=info

# 到期提醒（第三期 3a）：多少秒向门店取一次待发的订阅消息（默认 30；0 不发）；点开消息跳到哪一版小程序
# （formal 正式版，默认；测试网关配体验版时填 trial）
# MP_REMINDER_SECONDS=30
# MP_SUBSCRIBE_STATE=formal
