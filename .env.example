# ─────────────────────────────────────────────────────────────
# 浴族 yuzu 环境变量示例。复制为 .env 后按实际情况修改。
# .env 含密码，已被 .gitignore 排除，切勿提交到 GitHub。
# ─────────────────────────────────────────────────────────────

# 运行环境：development（本地开发）| trial（试用）| production（正式）
APP_ENV=trial

# 实例标识，登录页与导航栏常显：prod（正式服）| shadow（影子运行·不作数）| test（测试服·不作数）| demo（演示·不作数）
# 影子库、测试服演练库与正式服都是 APP_ENV=production，只能靠它区分；production 不设置时页面显示「未设置实例标识」
# YUZU_INSTANCE=prod

# 浏览器访问端口（Mac mini 上用 http://<Mac mini 局域网 IP>:8080 访问）。只写端口时开在所有网卡上，门店局域网这样用；
# 写成「地址:端口」只开在这个地址上：云服务器上写 127.0.0.1:8080（只给本机的 Caddy）或 <本机的 Tailscale 地址>:8080
# （Docker 发布的端口会绕过主机防火墙，不能只靠 ufw 挡；看门狗按同一个地址做健康检查；8.0.0，docs/RELEASE_V800.md）
APP_PORT=8080

# 外网正式服经反向代理（Caddy）走 HTTPS 时：登录 Cookie 加 Secure；信任代理转来的来源 IP 与 https（逗号分隔、可写网段）。
# TRUST_PROXY 填应用容器里看到的代理地址：Caddy 在同一台主机、经发布的端口连进来时是 Docker 网络的网关，不是 127.0.0.1——
#   docker network inspect <项目名>_default -f '{{range .IPAM.Config}}{{.Gateway}}{{end}}'
# COOKIE_SECURE=true
# TRUST_PROXY=172.18.0.1

# 同机运行多个环境时，项目名、应用端口、备份目录应各自独立。
# 镜像标签默认包含 Compose 项目名；也可以固定为经验证的版本标签。
# COMPOSE_PROJECT_NAME=yuzu-trial
# APP_IMAGE=yuzu-app:trial-<commit>

# 数据库密码：请改成足够长的随机字符串（例如 openssl rand -base64 24 的结果）
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# 首次启动时自动创建的店主账号（仅在数据库里还没有任何员工时生效）
# 密码至少 8 位，需同时包含字母和数字；首次登录后系统会要求修改
INIT_OWNER_USERNAME=owner
INIT_OWNER_PASSWORD=change-me-2026
INIT_OWNER_NAME=店主

# 门店时区与登录有效期（小时）
APP_TIMEZONE=Asia/Shanghai
SESSION_TTL_HOURS=12

# 备份目录：建议指向外置硬盘或另一块磁盘，例如 /Volumes/YuzuBackup/yuzu
BACKUP_DIR=./backups
# 备份服务每隔多少分钟备份一次（5–1440，默认 60）；每份都在临时库里试恢复、自检并记下数据指纹
BACKUP_INTERVAL_MINUTES=60
# 每天这个钟点（0–23，门店时区）之后的第一份记为 daily
BACKUP_HOUR=4
# 每小时的备份（hourly）保留多少小时；daily、升级前、恢复前与手动备份保留多少天
BACKUP_HOURLY_KEEP_HOURS=48
BACKUP_KEEP_DAYS=30
# 备份写外置盘时设为 true，并在备份目录里放一个空文件 .yuzu-backup-target（哨兵）：
# 外置盘没挂载、看不到哨兵时不备份，不往内置盘写
BACKUP_REQUIRE_SENTINEL=false

# 看门狗（scripts/watchdog.sh）告警推送：企业微信群机器人的 Webhook 地址。相当于密码，只写在 .env；不填只写日志
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...

# 备份加密用的 age 公钥（age1 开头；私钥只在店主手里，不能写在这里）：OSS 上传与异地副本共用
# AGE_RECIPIENT=age1...
# 异地副本（scripts/offsite-copy.sh，见 Mac mini 部署手册 9.8）：每份备份加密后经 Tailscale 用 SFTP 传到云服务器 A
# OFFSITE_TARGET=yuzubackup@yuzu-test
# OFFSITE_SSH_KEY=~/.ssh/yuzu_offsite
# OFFSITE_PORT=22
# 只传最近多少天的备份（服务器上同样保留 7 天）
# OFFSITE_KEEP_DAYS=7

# 微信小程序（小程序线，docs/MINIPROGRAM.md 第 12 节）：单开的小程序端口，只挂给网关的 /api/mp/*；不设 MP_PORT 就不开。
# 只经 Tailscale 让网关服务器连这个端口，不要做端口转发、不要对公网开放。三个密钥都只写在 .env，不进 GitHub
# MP_PORT=8081
# MP_HOST=0.0.0.0
# 网关的服务密钥：网关那边的 .env 填同一个值（至少 32 个字符，可以用 openssl rand -hex 32 生成）
# MP_GATEWAY_KEY=
# 会员码的签名密钥：只在 yuzu，网关不存（至少 32 个字符）
# MP_CODE_SECRET=

# 员工食堂 · 柚子饭堂（docs/CANTEEN.md 第 9 节）：单开的员工端口，只挂员工手机用的柚子饭堂与 /api/canteen/*；不设 CANTEEN_PORT 就不开。
# 公网入口是网关服务器上的 Caddy（HTTPS）经 Tailscale 转发到这个端口；备案前在测试服用 tailscale serve 发 https 地址。
# 还要在 ERP「模块设置」里打开「员工食堂」（默认关）。
# CANTEEN_PORT=8090
# CANTEEN_HOST=0.0.0.0
# 饭卡码的密钥（至少 32 个字符，openssl rand -hex 32）：只在 yuzu；换了它，大家要联网打开一次柚子饭堂才能亮码
# CANTEEN_CODE_SECRET=
# 员工端走 HTTPS 时设 true（Cookie 加 Secure）
# CANTEEN_COOKIE_SECURE=true
# 前面的转发服务器的地址（逗号分隔，可写网段）：登录限次按它转来的真实来源 IP 算；不设就不信任转发头
# CANTEEN_TRUST_PROXY=100.64.0.10

# 国内网络拉取镜像较慢时，可改用镜像源，例如：
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# NPM_REGISTRY=https://registry.npmmirror.com
# ALPINE_MIRROR=https://mirrors.aliyun.com/alpine

# 短信通道（8.0.4 批量发券的短信通知，docs/MEMBERSHIP_V804.md 第 6 节）：不配时短信留在待发箱，后台「批量发券」能导出名单手动发。
# aliyun：阿里云短信，四项都要配；「券到账」模板要先在阿里云短信控制台申请，模板变量 ${count}、${coupon}、${validTo}。
# mock 只给开发、测试用（不真发，直接记「已发」）；APP_ENV=production 时不认。密钥只放 .env，不要进 Git。
# 用 compose.yaml 部署时这几项由它传进应用容器（改了 .env 要重建容器：docker compose up -d app）。
# SMS_PROVIDER=aliyun
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_COUPON=
