{
  "name": "yuzu",
  "version": "8.1.21",
  "private": true,
  "description": "浴族 yuzu · 汤泉门店经营系统（会员充值、消费、撤销、流水与日结）",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build && node scripts/compress-assets.mjs && node scripts/check-ocr-assets.mjs dist/client/concierge/ocr && npm run build:canteen",
    "build:canteen": "vite build -c vite.canteen.config.ts && node scripts/compress-assets.mjs dist/canteen-app",
    "dev:canteen": "vite -c vite.canteen.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "migrate": "tsx src/server/cli.ts migrate",
    "seed": "tsx src/server/cli.ts seed-demo",
    "cli": "tsx src/server/cli.ts",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests e2e e2e-canteen scripts",
    "check:code": "node scripts/check-code.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:gov": "node scripts/check-governance.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "format": "prettier --write --log-level warn \"src/**/*.{ts,tsx,js,mjs,cjs}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"e2e-canteen/**/*.ts\" \"scripts/**/*.{ts,js,mjs,cjs}\" \"*.ts\"",
    "format:check": "prettier --check --log-level warn \"src/**/*.{ts,tsx,js,mjs,cjs}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"e2e-canteen/**/*.ts\" \"scripts/**/*.{ts,js,mjs,cjs}\" \"*.ts\"",
    "test": "vitest run",
    "test:unit": "node scripts/test-tiers.mjs unit",
    "test:quick": "node scripts/test-tiers.mjs quick",
    "test:plan": "node scripts/test-plan.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "@fontsource/playfair-display": "5.3.0",
    "@mlightcad/libredwg-web": "0.8.1",
    "fastify": "^5.12.7",
    "pdfjs-dist": "6.4.299",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/average-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@free-fonts/zhuque-fangsong": "1.0.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "jscpd": "5.4.2",
    "jsqr": "1.4.0",
    "knip": "6.44.1",
    "lightningcss": "1.32.0",
    "lucide-react": "^1.61.0",
    "oxlint": "1.91.0",
    "postcss": "8.5.31",
    "prettier": "3.8.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "uqr": "0.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@fastify/static": {
      "glob": "^14.0.3"
    },
    "pdfjs-dist": {
      "@napi-rs/canvas": "1.0.11"
    }
  }
}
