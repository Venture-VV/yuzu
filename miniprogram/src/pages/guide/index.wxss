.zoom {
  font-size: 26rpx;
  color: var(--ink);
  border-bottom: 1px solid var(--ink);
  line-height: 1.4;
}
.map {
  display: block;
  width: 100%;
  margin-top: 24rpx;
  background-color: var(--surface);
  border: 1px solid var(--line);
  border-radius: 6rpx;
  box-sizing: border-box;
}
.legend {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
}
.lg {
  display: flex;
  align-items: center;
  margin: 0 32rpx 16rpx 0;
  font-size: 24rpx;
}
.sw {
  width: 26rpx;
  height: 26rpx;
  margin-right: 10rpx;
  border-radius: 4rpx;
  border: 1px solid rgba(28, 26, 23, 0.12);
}
.glyph {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background-color: var(--ink);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lg-t {
  font-weight: 600;
}
.lg-en {
  margin-left: 8rpx;
  font-family: var(--font-en);
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: var(--muted);
}
.foot {
  display: block;
  margin-top: 16rpx;
}
