.act-hero {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 480rpx;
  overflow: hidden;
  color: var(--card-ink);
  background: radial-gradient(90% 70% at 78% 18%, rgba(235, 222, 202, 0.42) 0%, rgba(235, 222, 202, 0) 62%), linear-gradient(168deg, #8e6c4f 0%, #54402f 100%);
}
.act-hero-media {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.act-hero-img {
  width: 100%;
  height: 100%;
}
.act-hero-shade {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
}
.act-hero-body {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 44rpx;
  pointer-events: none;
}
.wordmark {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.wm-logo {
  width: 128rpx;
  height: 125rpx;
}
.wm-en {
  width: 128rpx;
  height: 19rpx;
  margin-top: 18rpx;
}
.act-hero-line {
  width: 64rpx;
  height: 1px;
  margin: 28rpx 0 22rpx;
  background-color: var(--card-muted);
}
.act-hero-tag {
  display: block;
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 0.1em;
}
.act-hero-en {
  display: block;
  margin-top: 6rpx;
  font-family: var(--font-en);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.24em;
  color: var(--card-muted);
}
