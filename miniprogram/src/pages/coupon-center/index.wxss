.coupon {
  display: flex;
  margin-bottom: 20rpx;
  background-color: var(--surface);
  border: 1px solid var(--line);
  border-radius: 8rpx;
  overflow: hidden;
}
.cp-left {
  flex: none;
  width: 184rpx;
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: var(--wood-6);
  border-right: 1px dashed var(--wood-3);
  text-align: center;
}
.cp-big {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.15;
}
.cp-big.long {
  font-size: 34rpx;
}
.cp-kind {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}
.cp-right {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx;
}
.cp-name {
  display: block;
  font-weight: 600;
}
.cp-meta {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
}
.cp-code {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  letter-spacing: 0.06em;
}
.coupon.off {
  opacity: 0.55;
}
.coupon.off .cp-left {
  background-color: var(--line);
}
.use-note {
  display: block;
  margin-top: 8rpx;
}
.later {
  margin-top: 56rpx;
}
.cp-why {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--wood);
}
.cp-act {
  flex: none;
  display: flex;
  align-items: center;
  padding-right: 20rpx;
}
.btn.mini {
  min-width: 132rpx;
  height: 64rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  line-height: 64rpx;
}
.note {
  margin-bottom: 20rpx;
}
.mine {
  margin-top: 32rpx;
}
