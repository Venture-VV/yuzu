.code-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 44rpx 28rpx 36rpx;
}
.who {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--muted);
}
.qr {
  margin: 32rpx 0 24rpx;
}
.digits {
  font-family: var(--font-en);
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  font-variant-numeric: tabular-nums;
}
.timer {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}
.hint {
  display: block;
  margin-top: 28rpx;
  text-align: center;
}
