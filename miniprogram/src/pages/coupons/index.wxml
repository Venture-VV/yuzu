<view class="view">
  <view wx:if="{{state === 'loading'}}" class="wait">正在打开…</view>
  <view wx:elif="{{state === 'unbound'}}" class="panel wait">
    <text class="h3">先绑定会员</text>
    <button class="btn primary" hover-class="btn-hover" bindtap="onBind">去绑定</button>
  </view>
  <view wx:elif="{{state === 'offline' || state === 'error'}}" class="panel wait">
    <text class="h3">{{state === 'offline' ? '门店系统连接中' : message}}</text>
    <text wx:if="{{state === 'offline'}}">券暂时看不到，店里网络恢复后就能看</text>
    <button class="btn ghost" hover-class="btn-hover" bindtap="load">再试一次</button>
  </view>
  <block wx:else>
    <view class="sec-h"><view><text class="eyebrow">Coupons</text><text class="h3">可以用的券</text></view></view>
    <view wx:if="{{!usable.length}}" class="wait">现在没有可以用的券</view>
    <view wx:for="{{usable}}" wx:key="code" class="coupon">
      <view class="cp-left"><text class="cp-big num">{{item.big}}</text><text class="cp-kind">{{item.kind}}</text></view>
      <view class="cp-right">
        <text class="cp-name">{{item.name}}</text>
        <text wx:if="{{item.terms}}" class="cp-meta">{{item.terms}}</text>
        <text class="cp-meta">{{item.valid}}</text>
        <text class="cp-code num">{{item.code}}</text>
      </view>
    </view>
    <text class="sub use-note">结账时告诉前台用哪张。每张结账单最多用 1 张，不找零，不和优惠、免单同时用。</text>

    <block wx:if="{{others.length}}">
      <view class="sec-h later"><view><text class="eyebrow">History</text><text class="h3">其他的券</text></view></view>
      <view wx:for="{{others}}" wx:key="code" class="coupon off">
        <view class="cp-left"><text class="cp-big num">{{item.big}}</text><text class="cp-kind">{{item.stateLabel}}</text></view>
        <view class="cp-right">
          <text class="cp-name">{{item.name}}</text>
          <text class="cp-meta">{{item.valid}}</text>
          <text class="cp-code num">{{item.code}}</text>
        </view>
      </view>
    </block>
  </block>
</view>
