/* 绑定 */
.bindcard {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 44rpx 32rpx 36rpx;
}
.bindcard .h3 {
  margin-top: 8rpx;
}
.lede {
  display: block;
  margin: 12rpx 0 36rpx;
  color: var(--muted);
}
.ghostcard {
  width: 100%;
  height: 200rpx;
  margin-bottom: 28rpx;
  border: 1px dashed var(--wood-3);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--wood);
}
.gc-zh {
  font-size: 44rpx;
  letter-spacing: 0.3em;
  margin-right: -0.3em;
}
.gc-en {
  font-family: var(--font-en);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 0.5em;
  margin-right: -0.5em;
}
.fine {
  display: block;
  margin-top: 20rpx;
}
.pair {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-gap: 16rpx;
}
.mock {
  width: 100%;
  text-align: left;
}
.mock-t {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}
.mock-in {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
  border: 1px solid var(--line);
  border-radius: 8rpx;
  background-color: #ffffff;
  font-family: var(--font-en);
  font-size: 32rpx;
  letter-spacing: 0.06em;
}

/* 会员卡：深木色卡面 */
.mcard {
  position: relative;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 12rpx;
  color: var(--card-ink);
  background: radial-gradient(120% 90% at 100% 0%, rgba(235, 222, 202, 0.36) 0%, rgba(235, 222, 202, 0) 55%), linear-gradient(150deg, var(--card-b), var(--card-a));
}
.mc-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.mc-eye {
  display: block;
  font-family: var(--font-en);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: var(--card-muted);
}
.mc-name {
  display: block;
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 600;
}
.mc-no {
  display: block;
  font-family: var(--font-en);
  font-size: 22rpx;
  letter-spacing: 0.08em;
  color: var(--card-muted);
}
.mc-mark {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  opacity: 0.85;
}
.mm-zh {
  font-size: 30rpx;
  letter-spacing: 0.24em;
  margin-right: -0.24em;
}
.mm-en {
  font-family: var(--font-en);
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 0.42em;
  margin-right: -0.42em;
}
.mc-level {
  display: flex;
  align-items: baseline;
  margin-top: 36rpx;
}
.lv-code {
  font-family: var(--font-en);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: var(--card-muted);
}
.lv-name {
  margin-left: 14rpx;
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
  line-height: 1;
}
.lv-tier {
  margin-left: 14rpx;
  padding: 0 10rpx;
  font-size: 26rpx;
  border: 1px solid var(--card-muted);
  border-radius: 4rpx;
  line-height: 1.5;
}
.ladder {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-top: 32rpx;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 20rpx;
  color: var(--card-muted);
}
.pip {
  width: 14rpx;
  height: 14rpx;
  margin-bottom: 8rpx;
  border-radius: 50%;
  background-color: var(--card-track);
}
.step.done .pip {
  background-color: var(--card-muted);
}
.step.cur {
  color: var(--card-ink);
  font-weight: 600;
}
.step.cur .pip {
  width: 22rpx;
  height: 22rpx;
  margin-top: -4rpx;
  margin-bottom: 4rpx;
  background-color: var(--card-ink);
  box-shadow: 0 0 0 6rpx var(--card-track);
}
.prog {
  margin-top: 32rpx;
}
.bar {
  position: relative;
  height: 8rpx;
  border-radius: 99rpx;
  background-color: var(--card-track);
}
.fill {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  border-radius: 99rpx;
  background-color: var(--card-ink);
}
.mark {
  position: absolute;
  top: -8rpx;
  width: 1px;
  height: 24rpx;
  background-color: var(--card-muted);
}
.bar-legend {
  position: relative;
  height: 36rpx;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--card-muted);
}
.bl-enjoy {
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  white-space: nowrap;
}
.bl-honor {
  position: absolute;
  right: 0;
  top: 0;
  white-space: nowrap;
}
.mc-text {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
}
.mc-muted {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--card-muted);
}

/* 余额 */
.bal {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 40rpx;
}
.k {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
}
.v {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: -0.01em;
  line-height: 1.2;
}
.bal-split {
  display: flex;
}
.bs {
  margin-left: 36rpx;
  text-align: right;
}
.nv {
  display: block;
  font-weight: 700;
}
.upsell {
  display: block;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1px solid var(--line);
  font-size: 26rpx;
}

/* 菜单 */
.menu {
  margin-top: 40rpx;
  border-top: 1px solid var(--line);
}
.mi {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 4rpx;
  border-bottom: 1px solid var(--line);
}
.mv {
  font-size: 26rpx;
  color: var(--muted);
}
.mv::after {
  content: "›";
  margin-left: 12rpx;
  font-size: 34rpx;
  line-height: 1;
}
.ver {
  display: block;
  margin-top: 56rpx;
  text-align: center;
  font-family: var(--font-en);
  font-size: 20rpx;
  letter-spacing: 0.16em;
  color: var(--muted);
}
